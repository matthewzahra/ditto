# backend
# NOTE - this is for secrets - do NOT expose to the frontend
ENV= # DEV or PROD
SECRET_KEY= # Django secret key
GMAIL_APP_PASSWORD= # used for sending emails from the gmail account
GEO_API_KEY= # used to interact with the geoapify api

# frontend config values
VITE_API= # API for frontend to fetch from - use "http://localhost:8000" for dev and "" for prod
VITE_WEBSOCKETAPI= # API for frontend to create websocket with - use "ws://localhost:8000/ws/" for dev and "" for prod